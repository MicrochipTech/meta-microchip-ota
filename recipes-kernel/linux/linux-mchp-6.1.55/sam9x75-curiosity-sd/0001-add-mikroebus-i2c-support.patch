From 9161fc71b5d54c5d07979ea211efd10404e1953a Mon Sep 17 00:00:00 2001
From: Matt Wood <matt.wood@microchip.com>
Date: Tue, 23 Jul 2024 13:54:31 -0400
Subject: [PATCH] add mikroebus i2c support

Signed-off-by: Matt Wood <matt.wood@microchip.com>
---
 arch/arm/boot/dts/at91-sam9x75_curiosity.dts | 23 ++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm/boot/dts/at91-sam9x75_curiosity.dts b/arch/arm/boot/dts/at91-sam9x75_curiosity.dts
index 7ed6e9c6c0e1..a8d3fac46291 100644
--- a/arch/arm/boot/dts/at91-sam9x75_curiosity.dts
+++ b/arch/arm/boot/dts/at91-sam9x75_curiosity.dts
@@ -16,6 +16,7 @@ / {
 
 	aliases {
 		i2c0 = &i2c6;
+		i2c1 = &i2c7;
 	};
 
 	chosen {
@@ -109,6 +110,22 @@ &ehci0 {
 	status = "okay";
 };
 
+&flx7 {
+	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
+	status = "okay";
+};
+
+&i2c7 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_flx7_twi_default>;
+	i2c-analog-filter;
+	i2c-digital-filter;
+	i2c-digital-filter-width-ns = <35>;
+	status = "okay";
+};
+
 &flx6 {
 	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_TWI>;
 	status = "okay";
@@ -303,6 +320,12 @@ pinctrl_flx6_twi_default: flx6-twi-default {
 				<AT91_PIOA 24 AT91_PERIPH_A AT91_PINCTRL_PULL_UP
 				 AT91_PIOA 25 AT91_PERIPH_A AT91_PINCTRL_PULL_UP>;
 		};
+
+		pinctrl_flx7_twi_default: flx7-twi-default {
+			atmel,pins =
+				<AT91_PIOC 0 AT91_PERIPH_C AT91_PINCTRL_PULL_UP
+				 AT91_PIOC 1 AT91_PERIPH_C AT91_PINCTRL_PULL_UP>;
+		};
 	};
 
 	gpio-keys {
-- 
2.34.1

